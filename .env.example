# Create a Resend API key at https://resend.com/api-keys and add it to your
# local .env.local file and your production hosting environment.
RESEND_API_KEY=re_your_resend_api_key

# Use a sender address from a domain verified in Resend.
EMAIL_FROM=Gill Organics <hello@your-verified-domain.com>

# Instagram Graph API Credentials
# Retrieve your Long-lived Access Token and User ID from Meta Developers portal.
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_access_token
INSTAGRAM_USER_ID=your_instagram_user_id
